{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Motorsport projects with timelines, galleries, and race results"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "specifications": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["Planning", "In Progress", "Completed", "On Hold"]
    },
    "category": {
      "type": "enumeration", 
      "enum": ["Track Racing", "Off-Road Rally", "Kart Racing", "Supercar Rebuild", "Other"]
    },
    "power_hp": {
      "type": "integer"
    },
    "engine_type": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "image_gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "video_gallery": {
      "type": "media", 
      "multiple": true,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "timeline_tasks": {
      "type": "json"
    },
    "race_results": {
      "type": "json"
    },
    "media_mentions": {
      "type": "json"
    },
    "technical_specs": {
      "type": "json"
    }
  }
}
