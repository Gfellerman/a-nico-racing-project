# Server Configuration
HOST=0.0.0.0
PORT=1337

# App Keys (generate new ones for production)
APP_KEYS=your-app-key-1,your-app-key-2,your-app-key-3,your-app-key-4

# Admin Panel
ADMIN_JWT_SECRET=your-admin-jwt-secret-here
JWT_SECRET=your-jwt-secret-here

# API Tokens
API_TOKEN_SALT=your-api-token-salt-here

# Transfer Token
TRANSFER_TOKEN_SALT=your-transfer-token-salt-here

# Database (SQLite for development)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Admin Panel URL (for Codespaces/remote environments)
# Replace with your actual Codespace URL
ADMIN_URL=https://your-codespace-url-1337.preview.app.github.dev/admin
PUBLIC_ADMIN_URL=https://your-codespace-url-1337.preview.app.github.dev/admin

# CORS Configuration
CORS_ENABLED=true
CORS_CREDENTIALS=true
CORS_ORIGIN=https://your-codespace-url-1337.preview.app.github.dev,http://localhost:1337,http://localhost:3000

# Security
ENCRYPTION_KEY=your-encryption-key-here

# Development flags
FLAG_NPS=false
FLAG_PROMOTE_EE=false
